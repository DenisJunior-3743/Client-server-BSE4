# Copy to /etc/loan-backend.env on the server and fill in.  chmod 640, owner root:loan.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
# Neon: use the DIRECT host (the one WITHOUT "-pooler" in its name).
DATABASE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
DATABASE_USER=<neon-user>
DATABASE_PASSWORD=<neon-password>
# Generate once:  openssl rand -base64 48
JWT_SECRET=<paste-the-generated-secret>
# The exact origin(s) of the dashboard, comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://client-server-bse-4.vercel.app

# MongoDB Atlas: file bytes only; PostgreSQL remains required.
MONGODB_URI=mongodb+srv://<encoded-user>:<encoded-password>@cluster0.zpptqmc.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=trustbank_documents
MONGODB_GRIDFS_BUCKET=loan_documents
# Creates the admin once; changing these does not reset an existing account.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@bank.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123
# Staff are registered by the admin. Enable old sample staff only for explicit demos.
SEED_DEMO_DATA=false
